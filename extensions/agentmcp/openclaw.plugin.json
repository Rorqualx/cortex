{
  "id": "agentmcp",
  "activation": {
    "onStartup": true
  },
  "enabledByDefault": false,
  "name": "AgentMCP",
  "description": "Multi-provider LLM delegation tools (code, review, research, delegate, explore, academic, swarm, vision) for GLM (Z.ai), DeepSeek, and Kimi (Moonshot).",
  "contracts": {
    "tools": [
      "agentmcp__glm__code",
      "agentmcp__glm__review",
      "agentmcp__glm__research",
      "agentmcp__glm__delegate",
      "agentmcp__glm__explore",
      "agentmcp__glm__academic",
      "agentmcp__glm__swarm",
      "agentmcp__glm__swarm_v2",
      "agentmcp__glm__vision",
      "agentmcp__deepseek__code",
      "agentmcp__deepseek__review",
      "agentmcp__deepseek__research",
      "agentmcp__deepseek__delegate",
      "agentmcp__deepseek__explore",
      "agentmcp__deepseek__academic",
      "agentmcp__deepseek__swarm",
      "agentmcp__deepseek__swarm_v2",
      "agentmcp__kimi__code",
      "agentmcp__kimi__review",
      "agentmcp__kimi__research",
      "agentmcp__kimi__delegate",
      "agentmcp__kimi__explore",
      "agentmcp__kimi__academic",
      "agentmcp__kimi__swarm",
      "agentmcp__kimi__swarm_v2",
      "agentmcp__kimi__vision",
      "agentmcp__kimi__plan"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "zaiApiKey": {
        "type": "string",
        "description": "Z.ai (GLM) API key. Falls back to ZAI_API_KEY env var."
      },
      "zaiBaseUrl": {
        "type": "string",
        "description": "Z.ai API base URL override."
      },
      "deepseekApiKey": {
        "type": "string",
        "description": "DeepSeek API key. Falls back to DEEPSEEK_API_KEY env var."
      },
      "deepseekBaseUrl": {
        "type": "string",
        "description": "DeepSeek API base URL override."
      },
      "kimiApiKey": {
        "type": "string",
        "description": "Kimi (Moonshot) API key. Falls back to KIMI_API_KEY env var."
      },
      "kimiBaseUrl": {
        "type": "string",
        "description": "Kimi API base URL override."
      }
    }
  }
}
